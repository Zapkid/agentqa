# Copy to .env and fill in. Never commit .env.
# Provider keys (all optional; the simulated adapter needs none).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Pipeline
AGENTQA_PROFILE=free            # free | mixed | premium | simulated
AGENTQA_CACHE_MODE=read_write   # off | read_write | replay_only
AGENTQA_CACHE_DIR=.cache/llm
AGENTQA_HOME=.agentqa           # run artifacts, SQLite stores, checkpoints
AGENTQA_KILLSWITCH_FILE=KILLSWITCH

# Observability (defaults match deploy/docker-compose.yml)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agentqa
AGENTQA_TRACING=1               # 0 disables span export (spans still recorded in-process)

# Target API (system under test)
BUGS=                           # e.g. B01,B03 ; empty = clean build
PERF_BUGS=                      # e.g. P01 ; empty = clean build
TARGET_WEBHOOK_SECRET=change-me-local-only

# Advanced
AGENTQA_EMBEDDER=hashing        # hashing (no download) | fastembed (BAAI/bge-small-en-v1.5, local ONNX)
AGENTQA_ANTHROPIC_EFFORT=low    # output_config.effort for Opus/Sonnet 5.5 (they reject temperature)
AGENTQA_SIM_SEED=0              # simulated models: repetition seed (use a cold cache when varying it)
AGENTQA_CACHE_DEBUG=            # set to a directory to dump every hashed LLM payload (replay debugging)
AGENTQA_LOG_LEVEL=WARNING
GRAFANA_ADMIN_PASSWORD=change-me-local-only
ALERT_WEBHOOK_URL=http://localhost:9999/alerts
