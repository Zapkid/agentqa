{
  "swagger": "2.0",
  "info": {
    "title": "Tasks API",
    "version": "1.0.0",
    "description": "A small multi-user task tracker. Authenticate with the X-API-Key header."
  },
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "X-API-Key"
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is up",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "List tasks",
        "operationId": "list_tasks",
        "description": "Users see their own tasks; admins see every task. Results are ordered by creation time.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          {
            "name": "page_size",
            "in": "query",
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          {
            "name": "status",
            "in": "query",
            "type": "string",
            "enum": [
              "open",
              "done"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "A page of tasks",
            "schema": {
              "$ref": "#/definitions/TaskPage"
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "Invalid query parameter",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "summary": "Create a task",
        "operationId": "create_task",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TaskIn"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "The created task",
            "schema": {
              "$ref": "#/definitions/Task"
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "Validation error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/tasks/{task_id}": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "get": {
        "summary": "Get a task",
        "operationId": "read_task",
        "responses": {
          "200": {
            "description": "The task",
            "schema": {
              "$ref": "#/definitions/Task"
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "No such task, or it belongs to another user",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "Malformed id",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "patch": {
        "summary": "Edit a task",
        "operationId": "update_task",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TaskPatch"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The updated task",
            "schema": {
              "$ref": "#/definitions/Task"
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "No such task, or it belongs to another user",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The task is already completed",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "Validation error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a task",
        "operationId": "delete_task",
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Missing or invalid API key",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "No such task, or it belongs to another user",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "Malformed id",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    },
    "/tasks/{task_id}/complete": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "post": {
        "summary": "Mark a task completed",
        "operationId": "complete_task",
        "responses": {
          "200": {
            "description": "The completed task",
            "schema": {
              "$ref": "#/definitions/Task"
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "No such task, or it belongs to another user",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "The task is already completed",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "Malformed id",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "detail"
      ]
    },
    "Task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "priority",
        "status",
        "owner_id",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "x-nullable": true
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done"
          ]
        },
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "due_date": {
          "type": "string",
          "format": "date",
          "x-nullable": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "TaskIn": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        },
        "due_date": {
          "type": "string",
          "format": "date",
          "description": "Must not be in the past"
        }
      }
    },
    "TaskPatch": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "due_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "TaskPage": {
      "type": "object",
      "required": [
        "items",
        "page",
        "page_size",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Task"
          }
        },
        "page": {
          "type": "integer"
        },
        "page_size": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    }
  }
}
