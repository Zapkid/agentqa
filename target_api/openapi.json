{
  "components": {
    "schemas": {
      "Customer": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "created_at"
        ],
        "title": "Customer",
        "type": "object"
      },
      "Error": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "Error",
        "type": "object"
      },
      "Invoice": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "issued_at": {
            "format": "date-time",
            "title": "Issued At",
            "type": "string"
          },
          "order_id": {
            "format": "uuid",
            "title": "Order Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "order_id",
          "amount",
          "status",
          "issued_at"
        ],
        "title": "Invoice",
        "type": "object"
      },
      "Order": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "customer_id": {
            "format": "uuid",
            "title": "Customer Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "title": "Items",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "total": {
            "title": "Total",
            "type": "string"
          }
        },
        "required": [
          "id",
          "customer_id",
          "status",
          "items",
          "total",
          "currency",
          "created_at"
        ],
        "title": "Order",
        "type": "object"
      },
      "OrderIn": {
        "properties": {
          "customer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for staff/admin; customers always order for themselves",
            "format": "uuid",
            "title": "Customer Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemIn"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "OrderIn",
        "type": "object"
      },
      "OrderItem": {
        "properties": {
          "line_total": {
            "description": "unit_price * quantity rounded half-up to cents",
            "title": "Line Total",
            "type": "string"
          },
          "product_id": {
            "format": "uuid",
            "title": "Product Id",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "unit_price": {
            "title": "Unit Price",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "quantity",
          "unit_price",
          "line_total"
        ],
        "title": "OrderItem",
        "type": "object"
      },
      "OrderItemIn": {
        "properties": {
          "product_id": {
            "format": "uuid",
            "title": "Product Id",
            "type": "string"
          },
          "quantity": {
            "description": "Units ordered, 1..1000",
            "examples": [
              2
            ],
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "OrderItemIn",
        "type": "object"
      },
      "OrderPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "OrderPage",
        "type": "object"
      },
      "OrderStatus": {
        "enum": [
          "pending",
          "paid",
          "cancelled",
          "shipped"
        ],
        "title": "OrderStatus",
        "type": "string"
      },
      "Product": {
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "price": {
            "description": "Unit price as a decimal string with up to 3 decimals",
            "examples": [
              "19.99"
            ],
            "title": "Price",
            "type": "string"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "price",
          "currency",
          "active"
        ],
        "title": "Product",
        "type": "object"
      },
      "ProductPatch": {
        "properties": {
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "price": {
            "anyOf": [
              {
                "pattern": "^\\d{1,6}(\\.\\d{1,3})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "21.50"
            ],
            "title": "Price"
          }
        },
        "title": "ProductPatch",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Opaque role token, e.g. `Bearer tok-admin`",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Customers, products, orders, invoices and a signed payment webhook. All endpoints except /health and /webhooks/payment require `Authorization: Bearer <token>`.",
    "title": "Orders and Invoicing API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
