FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.115" "uvicorn>=0.32" "pydantic>=2.9" \
    "opentelemetry-sdk>=1.45" "opentelemetry-exporter-otlp-proto-http>=1.45"
COPY target_api /app/target_api
EXPOSE 8000
CMD ["uvicorn", "target_api.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
