   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (agent) (rate(agentqa_llm_tokens_total[5m]))",
     "legendFormat": "{{agent}}"
    }
   ]
