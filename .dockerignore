# state, secrets and bulky folders out of the context entirely.
.env
.env.*
.git
.venv
.cache
.agentqa
.mypy_cache
.ruff_cache
.pytest_cache
**/__pycache__
runs
htmlcov
tests
docs
scripts
evals
results
examples
deploy
media/veroniqa
