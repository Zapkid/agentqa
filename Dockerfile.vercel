# VeroniQA public demo on Vercel (container image function). One ASGI app serves the home page,
# the public API, the developer portal and the Streamlit UI at /talk/
# (agentqa/veroniqa/server.py). Hosted mode: per-visitor temporary workspaces, simulated models
# (no API keys on the server), test runs only against the bundled Orders API. See docs/DEPLOY.md.
#
# Vercel stores every deployment's image, so size matters twice: two stages keep uv, its download
# cache (as large as the environment itself) and the build layers out of the image that ships, and
# the packages that only the command line uses (load testing, charts) or that Chroma needs only
# for its server mode are removed from the environment. Together that takes the image from about
# 2.1 GB to under 1 GB.

# ---- build: install the locked dependencies, then trim them
FROM python:3.12-slim-bookworm AS build

ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never

RUN pip install --no-cache-dir uv==0.13.4

WORKDIR /app

# Dependencies first (cached layer), from the lockfile, without the dev group.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --no-install-project

# Only what the app needs at run time: no tests, docs, scripts, evals or screenshots.
COPY agentqa ./agentqa
COPY target_api ./target_api
COPY config ./config
COPY prompts ./prompts
COPY .streamlit ./.streamlit
COPY media/videos/veroniqa-intro.mp4 media/videos/veroniqa-intro.jpg media/videos/veroniqa-intro.srt ./media/videos/
RUN uv sync --locked --no-dev

# Not used by the website: locust and matplotlib serve `agentqa perf` and `agentqa eval` only
# (hosted mode never runs either), and kubernetes and onnxruntime are Chroma dependencies for its
# distributed server and default embedding model, while VeroniQA embeds with its own local hashing.
# The smoke test fails the build, instead of the deploy, if the app ever starts needing one.
RUN uv pip uninstall --python /app/.venv/bin/python \
        locust gevent geventhttpclient pyzmq flask flask-cors flask-login \
        matplotlib contourpy kiwisolver cycler fonttools \
        kubernetes onnxruntime \
    && /app/.venv/bin/python -c "import agentqa.veroniqa.server"

# ---- run: the base image plus the finished /app, nothing else
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY --from=build /app /app

# Pull the current Debian trust store even when the base image tag is cached (eMudhra CA
# compromise, October 2026). Python clients use certifi from uv.lock; this covers the rest.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin veroniqa
USER 10001

ENV VERONIQA_HOSTED=1 \
    AGENTQA_PROFILE=simulated \
    AGENTQA_HOME=/tmp/veroniqa \
    AGENTQA_CACHE_DIR=/tmp/veroniqa/cache \
    HOME=/tmp \
    PATH="/app/.venv/bin:$PATH"

EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn agentqa.veroniqa.server:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*' --log-level warning"]
