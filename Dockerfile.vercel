# VeroniQA public demo on Vercel (container image function). One ASGI app serves the home page,
# the public API, the developer portal and the Streamlit UI at /talk/
# (agentqa/veroniqa/server.py). Hosted mode: per-visitor temporary workspaces, simulated models
# (no API keys on the server), test runs only against the bundled Orders API. See docs/DEPLOY.md.
#
# Vercel keeps the image of every deployment, so what each deployment ADDS to the registry matters
# more than the size of one image. A registry stores a layer once, keyed by its content, so:
#   - the dependencies are one layer of their own, built to be byte-identical from build to build
#     (same lockfile in, same bytes out: timestamps fixed, bytecode that does not record them, no
#     project metadata inside), so every deployment after the first reuses it;
#   - the video and the code are separate small layers on top, each built with its file times
#     fixed, so a code change adds a few MB (and nothing at all for the unchanged video) instead
#     of a whole new copy of the environment.
# The image itself is kept small too: packages only the command line uses (load testing, charts)
# or that Chroma needs only for its server mode are removed, and uv and its cache are not shipped.

# ---- deps: the locked dependencies, trimmed, as a reproducible tree
FROM python:3.12-slim-bookworm AS deps

ENV PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never

RUN pip install --no-cache-dir uv==0.11.32

WORKDIR /app

# Only the lockfile decides this layer (the project itself is not installed: the code runs from
# /app, see PYTHONPATH below), and no dev group.
COPY pyproject.toml uv.lock README.md ./
# Not used by the website: locust and matplotlib serve `agentqa perf` and `agentqa eval` only
# (hosted mode never runs either), and kubernetes and onnxruntime are Chroma dependencies for its
# distributed server and default embedding model, while VeroniQA embeds with its own local hashing.
# Then make the tree reproducible: bytecode compiled by content hash (it never goes stale in an
# image, and does not record file times), compiled serially with a fixed hash seed (set constants
# are marshalled in hash order, and whether an object is marked shared depends on which files the
# same process compiled before it, so parallel workers give different bytes from run to run), and
# every file's time set to the epoch.
RUN uv sync --locked --no-dev --no-install-project \
    && uv pip uninstall --python /app/.venv/bin/python \
        locust gevent geventhttpclient pyzmq flask flask-cors flask-login \
        matplotlib contourpy kiwisolver cycler fonttools \
        kubernetes onnxruntime \
    && PYTHONHASHSEED=0 /app/.venv/bin/python -m compileall -q -f \
        --invalidation-mode unchecked-hash /app/.venv \
    && find /app/.venv -exec touch -h -d @0 {} +

# ---- assets: the video, with file times fixed (COPY keeps them, and a checkout's differ every build)
FROM python:3.12-slim-bookworm AS assets
WORKDIR /app
COPY media/videos/veroniqa-intro.mp4 media/videos/veroniqa-intro.jpg media/videos/veroniqa-intro.srt ./media/videos/
RUN find /app -exec touch -h -d @0 {} +

# ---- src: the code, compiled once by content hash (so a cold start does not compile it), with the
# same fixed file times. Built from the dependencies' stage so that the right Python compiles it,
# at the path it runs from, which is the path that shows in tracebacks.
FROM deps AS src
WORKDIR /app
# Only what the app needs at run time: no tests, docs, scripts, evals or screenshots.
COPY target_api ./target_api
COPY config ./config
COPY prompts ./prompts
COPY .streamlit ./.streamlit
COPY agentqa ./agentqa
RUN PYTHONHASHSEED=0 /app/.venv/bin/python -m compileall -q \
        --invalidation-mode unchecked-hash agentqa target_api \
    && find agentqa target_api config prompts .streamlit -exec touch -h -d @0 {} +

# ---- run: the base image, the dependencies, then the media and the code (smallest changes last)
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin veroniqa

WORKDIR /app
COPY --from=deps /app/.venv /app/.venv
COPY --from=assets /app/media /app/media
COPY --from=src /app/target_api /app/target_api
COPY --from=src /app/config /app/config
COPY --from=src /app/prompts /app/prompts
COPY --from=src /app/.streamlit /app/.streamlit
COPY --from=src /app/agentqa /app/agentqa

# Fail the build, not the deploy, if the app cannot start (for example if it began to need one of
# the packages removed above). Nothing is written: bytecode is off and the code is precompiled.
RUN /app/.venv/bin/python -c "import agentqa.veroniqa.server"

USER 10001

ENV VERONIQA_HOSTED=1 \
    AGENTQA_PROFILE=simulated \
    AGENTQA_HOME=/tmp/veroniqa \
    AGENTQA_CACHE_DIR=/tmp/veroniqa/cache \
    HOME=/tmp \
    PATH="/app/.venv/bin:$PATH"

EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn agentqa.veroniqa.server:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*' --log-level warning"]
